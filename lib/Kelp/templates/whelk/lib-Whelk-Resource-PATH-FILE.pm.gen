package Whelk::Resource::[% name %];

use Kelp::Base 'Whelk::Resource';
use Whelk::Schema;

sub schemas
{
    Whelk::Schema->build(
        my_model => {
            type => 'object',
            properties => {
                field => {
                    type => 'integer',
                },
            },
        }
    );
}

sub api
{
    my ($self) = @_;

    $self->add_endpoint(
        [GET => '/'] => 'action_show',
        description => 'Returns a single instance of my_model',
        response => \'my_model',
    );
}

sub action_show
{
    return {
        field => 313,
    };
}

1;

